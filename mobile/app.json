{
  "expo": {
    "name": "Saude App",
    "slug": "saude-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "saudeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
